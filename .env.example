# Production values (decisions.md question 6: working answers, not final).
ENV=production
DATABASE_URL=postgres://meetspace:CHANGE_ME@db:5432/meetspace?sslmode=disable
DB_PASSWORD=CHANGE_ME
PGDATA_DIR=/srv/pgdata
PLATFORM_NAME=meet.space
PUBLIC_HOST=meet.space
PUBLIC_BASE_URL=https://meet.space
ORIGIN_HOST=origin.meet.space
HOST_SOURCE=host                 # set from the Phase 9 spike
TRUSTED_PROXIES=                 # Caddy's address on the compose network
CLIENT_IP_HEADER=X-Forwarded-For # set from the Phase 9 spike
APP_SECRET=                      # at least 32 random bytes
SES_REGION=
SES_CONFIG_SET_AUTH=
SES_CONFIG_SET_NOTIFY=
SES_FROM_AUTH=login@auth.meet.space
SES_FROM_NOTIFY=notifications@mail.meet.space
SES_REPLY_TO=
SNS_TOPIC_ARN=
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
S3_REGION=
S3_BUCKET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_EMBED_KEY=
# No AWS keys: on EC2 the SDK uses the instance role.
